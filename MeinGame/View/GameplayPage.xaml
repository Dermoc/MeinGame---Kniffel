<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="MeinGame.View.GameplayPage"
    xmlns="http://schemas.microsoft.com/dotnet/maui/global"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:d="http://schemas.microsoft.com/dotnet/maui/global/design"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewmodel="clr-namespace:MeinGame.ViewModel"
    xmlns:local="clr-namespace:MeinGame.View"
    mc:Ignorable="d">
    <ContentPage.Content>




        <Grid ColumnDefinitions="*, Auto">


            <Grid Grid.Column="0">

                <Grid ColumnDefinitions="*,*,*"
                      RowDefinitions="Auto,*,*,*,*,*,*,*,*,*,*,*,*,*,*,*,*,*,*">

                    <!-- ZEILE 0: TABELLENKOPF MIT AKTIV-HERVORHEBUNG -->
                    <Border Grid.Row="0" Grid.Column="0" BackgroundColor="#EFEFEF">
                        <Label Text="Kategorie" FontAttributes="Bold" HorizontalTextAlignment="Center" VerticalOptions="Center"/>
                    </Border>

                    <!-- Spieler 1 Header -->
                    <Border Grid.Row="0" Grid.Column="1" StrokeShape="RoundRectangle 4">
                        <Border.Triggers>
                            <DataTrigger TargetType="Border" Binding="{Binding IsPlayerOneTurn}" Value="True">
                                <Setter Property="BackgroundColor" Value="#D4EDDA"/>
                                <Setter Property="Stroke" Value="#28A745"/>
                                <Setter Property="StrokeThickness" Value="2"/>
                            </DataTrigger>
                            <DataTrigger TargetType="Border" Binding="{Binding IsPlayerOneTurn}" Value="False">
                                <Setter Property="BackgroundColor" Value="Transparent"/>
                                <Setter Property="Stroke" Value="LightGray"/>
                                <Setter Property="StrokeThickness" Value="1"/>
                            </DataTrigger>
                        </Border.Triggers>
                        <Label Text="{Binding Spieler1.PlayerName}" FontAttributes="Bold" HorizontalTextAlignment="Center" VerticalOptions="Center"/>
                    </Border>

                    <!-- Spieler 2 Header -->
                    <Border Grid.Row="0" Grid.Column="2" StrokeShape="RoundRectangle 4">
                        <Border.Triggers>
                            <DataTrigger TargetType="Border" Binding="{Binding IsPlayerOneTurn}" Value="False">
                                <Setter Property="BackgroundColor" Value="#D4EDDA"/>
                                <Setter Property="Stroke" Value="#28A745"/>
                                <Setter Property="StrokeThickness" Value="2"/>
                            </DataTrigger>
                            <DataTrigger TargetType="Border" Binding="{Binding IsPlayerOneTurn}" Value="True">
                                <Setter Property="BackgroundColor" Value="Transparent"/>
                                <Setter Property="Stroke" Value="LightGray"/>
                                <Setter Property="StrokeThickness" Value="1"/>
                            </DataTrigger>
                        </Border.Triggers>
                        <Label Text="{Binding Spieler2.PlayerName}" FontAttributes="Bold" HorizontalTextAlignment="Center" VerticalOptions="Center"/>
                    </Border>

                    <!-- EINSER (Zeile 1) -->
                    <Border Grid.Row="1" Grid.Column="0">
                        <Label Text="1er"/>
                    </Border>
                    <Border Grid.Row="1" Grid.Column="1">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ErgebnisEintragenCommand}" CommandParameter="Einser" />
                        </Border.GestureRecognizers>
                        <Label Text="{Binding Spieler1.Einser}" HorizontalTextAlignment="Center"/>
                    </Border>
                    <Border Grid.Row="1" Grid.Column="2">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ErgebnisEintragenCommand}" CommandParameter="Einser" />
                        </Border.GestureRecognizers>
                        <Label Text="{Binding Spieler2.Einser}" HorizontalTextAlignment="Center"/>
                    </Border>

                    <!-- ZWEIER (Zeile 2) -->
                    <Border Grid.Row="2" Grid.Column="0">
                        <Label Text="2er"/>
                    </Border>
                    <Border Grid.Row="2" Grid.Column="1">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ErgebnisEintragenCommand}" CommandParameter="Zweier" />
                        </Border.GestureRecognizers>
                        <Label Text="{Binding Spieler1.Zweier}" HorizontalTextAlignment="Center"/>
                    </Border>
                    <Border Grid.Row="2" Grid.Column="2">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ErgebnisEintragenCommand}" CommandParameter="Zweier" />
                        </Border.GestureRecognizers>
                        <Label Text="{Binding Spieler2.Zweier}" HorizontalTextAlignment="Center"/>
                    </Border>

                    <!-- DREIER (Zeile 3) -->
                    <Border Grid.Row="3" Grid.Column="0">
                        <Label Text="3er"/>
                    </Border>
                    <Border Grid.Row="3" Grid.Column="1">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ErgebnisEintragenCommand}" CommandParameter="Dreier" />
                        </Border.GestureRecognizers>
                        <Label Text="{Binding Spieler1.Dreier}" HorizontalTextAlignment="Center"/>
                    </Border>
                    <Border Grid.Row="3" Grid.Column="2">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ErgebnisEintragenCommand}" CommandParameter="Dreier" />
                        </Border.GestureRecognizers>
                        <Label Text="{Binding Spieler2.Dreier}" HorizontalTextAlignment="Center"/>
                    </Border>

                    <!-- VIERER (Zeile 4) -->
                    <Border Grid.Row="4" Grid.Column="0">
                        <Label Text="4er"/>
                    </Border>
                    <Border Grid.Row="4" Grid.Column="1">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ErgebnisEintragenCommand}" CommandParameter="Vierer" />
                        </Border.GestureRecognizers>
                        <Label Text="{Binding Spieler1.Vierer}" HorizontalTextAlignment="Center"/>
                    </Border>
                    <Border Grid.Row="4" Grid.Column="2">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ErgebnisEintragenCommand}" CommandParameter="Vierer" />
                        </Border.GestureRecognizers>
                        <Label Text="{Binding Spieler2.Vierer}" HorizontalTextAlignment="Center"/>
                    </Border>

                    <!-- FÜNFER (Zeile 5) -->
                    <Border Grid.Row="5" Grid.Column="0">
                        <Label Text="5er"/>
                    </Border>
                    <Border Grid.Row="5" Grid.Column="1">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ErgebnisEintragenCommand}" CommandParameter="Fuenfer" />
                        </Border.GestureRecognizers>
                        <Label Text="{Binding Spieler1.Fuenfer}" HorizontalTextAlignment="Center"/>
                    </Border>
                    <Border Grid.Row="5" Grid.Column="2">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ErgebnisEintragenCommand}" CommandParameter="Fuenfer" />
                        </Border.GestureRecognizers>
                        <Label Text="{Binding Spieler2.Fuenfer}" HorizontalTextAlignment="Center"/>
                    </Border>

                    <!-- SECHSER (Zeile 6) -->
                    <Border Grid.Row="6" Grid.Column="0">
                        <Label Text="6er"/>
                    </Border>
                    <Border Grid.Row="6" Grid.Column="1">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ErgebnisEintragenCommand}" CommandParameter="Sechser" />
                        </Border.GestureRecognizers>
                        <Label Text="{Binding Spieler1.Sechser}" HorizontalTextAlignment="Center"/>
                    </Border>
                    <Border Grid.Row="6" Grid.Column="2">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ErgebnisEintragenCommand}" CommandParameter="Sechser" />
                        </Border.GestureRecognizers>
                        <Label Text="{Binding Spieler2.Sechser}" HorizontalTextAlignment="Center"/>
                    </Border>
                    
                    
                    
                    <!-- GESAMT OBEN (Zeile 7) -->
                    <Border Grid.Row="7" Grid.Column="0">
                        <Label Text="Gesamt Oben" FontAttributes="Bold"/>
                    </Border>
                    <Border Grid.Row="7" Grid.Column="1">
                        <Label Text="{Binding Spieler1.GesamtOben}" FontAttributes="Bold"/>
                    </Border>
                    <Border Grid.Row="7" Grid.Column="2">
                        <Label Text="{Binding Spieler2.GesamtOben}" FontAttributes="Bold"/>
                    </Border>

                    <!-- BONUS (Zeile 8) -->
                    <Border Grid.Row="8" Grid.Column="0">
                        <Label Text="Bonus"/>
                    </Border>
                    <Border Grid.Row="8" Grid.Column="1">
                        <Label Text="{Binding Spieler1.Bonus}"/>
                    </Border>
                    <Border Grid.Row="8" Grid.Column="2">
                        <Label Text="{Binding Spieler2.Bonus}"/>
                    </Border>

                    <!-- ÜBERTRAG OBEN (Zeile 9) -->
                    <Border Grid.Row="9" Grid.Column="0">
                        <Label Text="Übertrag Oben" FontAttributes="Bold"/>
                    </Border>
                    <Border Grid.Row="9" Grid.Column="1">
                        <Label Text="{Binding Spieler1.GesamtOben}" FontAttributes="Bold"/>
                    </Border>
                    <Border Grid.Row="9" Grid.Column="2">
                        <Label Text="{Binding Spieler2.GesamtOben}" FontAttributes="Bold"/>
                    </Border>

                    <!-- 3ER PASCH (Zeile 10) -->
                    <Border Grid.Row="10" Grid.Column="0">
                        <Label Text="3er Pasch"/>
                    </Border>
                    <Border Grid.Row="10" Grid.Column="1">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ErgebnisEintragenCommand}" CommandParameter="DreierPasch" />
                        </Border.GestureRecognizers>
                        <Label Text="{Binding Spieler1.DreierPasch}" HorizontalTextAlignment="Center"/>
                    </Border>
                    <Border Grid.Row="10" Grid.Column="2">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ErgebnisEintragenCommand}" CommandParameter="DreierPasch" />
                        </Border.GestureRecognizers>
                        <Label Text="{Binding Spieler2.DreierPasch}" HorizontalTextAlignment="Center"/>
                    </Border>

                    <!-- 4ER PASCH (Zeile 11) -->
                    <Border Grid.Row="11" Grid.Column="0">
                        <Label Text="4er Pasch"/>
                    </Border>
                    <Border Grid.Row="11" Grid.Column="1">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ErgebnisEintragenCommand}" CommandParameter="ViererPasch" />
                        </Border.GestureRecognizers>
                        <Label Text="{Binding Spieler1.ViererPasch}" HorizontalTextAlignment="Center"/>
                    </Border>
                    <Border Grid.Row="11" Grid.Column="2">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ErgebnisEintragenCommand}" CommandParameter="ViererPasch" />
                        </Border.GestureRecognizers>
                        <Label Text="{Binding Spieler2.ViererPasch}" HorizontalTextAlignment="Center"/>
                    </Border>

                    <!-- FULL HOUSE (Zeile 12) -->
                    <Border Grid.Row="12" Grid.Column="0">
                        <Label Text="Full House"/>
                    </Border>
                    <Border Grid.Row="12" Grid.Column="1">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ErgebnisEintragenCommand}" CommandParameter="FullHouse" />
                        </Border.GestureRecognizers>
                        <Label Text="{Binding Spieler1.FullHouse}" HorizontalTextAlignment="Center"/>
                    </Border>
                    <Border Grid.Row="12" Grid.Column="2">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ErgebnisEintragenCommand}" CommandParameter="FullHouse" />
                        </Border.GestureRecognizers>
                        <Label Text="{Binding Spieler2.FullHouse}" HorizontalTextAlignment="Center"/>
                    </Border>

                    <!-- KL. STRASSE (Zeile 13) -->
                    <Border Grid.Row="13" Grid.Column="0">
                        <Label Text="Kl. Strasse"/>
                    </Border>
                    <Border Grid.Row="13" Grid.Column="1">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ErgebnisEintragenCommand}" CommandParameter="KleineStrasse" />
                        </Border.GestureRecognizers>
                        <Label Text="{Binding Spieler1.KleineStrasse}" HorizontalTextAlignment="Center"/>
                    </Border>
                    <Border Grid.Row="13" Grid.Column="2">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ErgebnisEintragenCommand}" CommandParameter="KleineStrasse" />
                        </Border.GestureRecognizers>
                        <Label Text="{Binding Spieler2.KleineStrasse}" HorizontalTextAlignment="Center"/>
                    </Border>

                    <!-- GR. STRASSE (Zeile 14) -->
                    <Border Grid.Row="14" Grid.Column="0">
                        <Label Text="Gr. Strasse"/>
                    </Border>
                    <Border Grid.Row="14" Grid.Column="1">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ErgebnisEintragenCommand}" CommandParameter="GrosseStrasse" />
                        </Border.GestureRecognizers>
                        <Label Text="{Binding Spieler1.GrosseStrasse}" HorizontalTextAlignment="Center"/>
                    </Border>
                    <Border Grid.Row="14" Grid.Column="2">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ErgebnisEintragenCommand}" CommandParameter="GrosseStrasse" />
                        </Border.GestureRecognizers>
                        <Label Text="{Binding Spieler2.GrosseStrasse}" HorizontalTextAlignment="Center"/>
                    </Border>

                    <!-- JEPJEP (Zeile 15) -->
                    <Border Grid.Row="15" Grid.Column="0">
                        <Label Text="JepJep"/>
                    </Border>
                    <Border Grid.Row="15" Grid.Column="1">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ErgebnisEintragenCommand}" CommandParameter="JepJep" />
                        </Border.GestureRecognizers>
                        <Label Text="{Binding Spieler1.JepJep}" HorizontalTextAlignment="Center"/>
                    </Border>
                    <Border Grid.Row="15" Grid.Column="2">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ErgebnisEintragenCommand}" CommandParameter="JepJep" />
                        </Border.GestureRecognizers>
                        <Label Text="{Binding Spieler2.JepJep}" HorizontalTextAlignment="Center"/>
                    </Border>

                    <!-- CHANCE (Zeile 16) -->
                    <Border Grid.Row="16" Grid.Column="0">
                        <Label Text="Chance"/>
                    </Border>
                    <Border Grid.Row="16" Grid.Column="1">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ErgebnisEintragenCommand}" CommandParameter="Chance" />
                        </Border.GestureRecognizers>
                        <Label Text="{Binding Spieler1.Chance}" HorizontalTextAlignment="Center"/>
                    </Border>
                    <Border Grid.Row="16" Grid.Column="2">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ErgebnisEintragenCommand}" CommandParameter="Chance" />
                        </Border.GestureRecognizers>
                        <Label Text="{Binding Spieler2.Chance}" HorizontalTextAlignment="Center"/>
                    </Border>

                    <!-- GESAMT UNTEN (Zeile 17) -->
                    <Border Grid.Row="17" Grid.Column="0">
                        <Label Text="Gesamt Unten" FontAttributes="Bold"/>
                    </Border>
                    <Border Grid.Row="17" Grid.Column="1">
                        <Label Text="{Binding Spieler1.GesamtUnten}" FontAttributes="Bold"/>
                    </Border>
                    <Border Grid.Row="17" Grid.Column="2">
                        <Label Text="{Binding Spieler2.GesamtUnten}" FontAttributes="Bold"/>
                    </Border>

                    <!-- GESAMT ALLES (Zeile 18) -->
                    <Border Grid.Row="18" Grid.Column="0">
                        <Label Text="Gesamt Alles" FontAttributes="Bold"/>
                    </Border>
                    <Border Grid.Row="18" Grid.Column="1">
                        <Label Text="{Binding Spieler1.Endsumme}" FontAttributes="Bold"/>
                    </Border>
                    <Border Grid.Row="18" Grid.Column="2">
                        <Label Text="{Binding Spieler2.Endsumme}" FontAttributes="Bold"/>
                    </Border>

                </Grid>
            </Grid>



            <!-- RECHTE SEITE: Statusanzeige, Würfel und Button -->
            <Grid Grid.Column="1" RowDefinitions="Auto, *, Auto" Margin="10">

                <!-- 1. Status-Infokarte -->
                <Border Grid.Row="0"
                        Stroke="#CCCCCC"
                        StrokeShape="RoundRectangle 8"
                        BackgroundColor="#F8F9FA"
                        Padding="12"
                        Margin="0,0,0,10">
                    <VerticalStackLayout Spacing="4">
                        <HorizontalStackLayout HorizontalOptions="Center" Spacing="6">
                            <Label Text="Am Zug:" FontSize="14" TextColor="Gray"/>
                            <Label Text="{Binding AktuellerSpielerName}" FontSize="16" FontAttributes="Bold" TextColor="#28A745"/>
                        </HorizontalStackLayout>

                        <Label Text="{Binding WurfStatusText}" 
                               FontSize="18" 
                               FontAttributes="Bold" 
                               HorizontalOptions="Center" 
                               TextColor="Black"/>

                        <Label Text="{Binding VerbleibendeWuerfeText}" 
                               FontSize="12" 
                               HorizontalOptions="Center" 
                               TextColor="Gray"/>
                    </VerticalStackLayout>
                </Border>

                <!-- 2. Die 5 Würfel -->
                <HorizontalStackLayout Grid.Row="1"
                                       BindableLayout.ItemsSource="{Binding WuerfelListe}"
                                       Spacing="10"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate>
                            <Border WidthRequest="60" 
                                    HeightRequest="60" 
                                    Stroke="Black" 
                                    StrokeThickness="2"
                                    StrokeShape="RoundRectangle 8">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer 
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodel:GameplayViewModel}}, Path=WuerfelSperrenCommand}"
                                        CommandParameter="{Binding .}" />
                                </Border.GestureRecognizers>
                                <Border.Triggers>
                                    <DataTrigger TargetType="Border" Binding="{Binding IstGesperrt}" Value="True">
                                        <Setter Property="BackgroundColor" Value="LightGray" />
                                    </DataTrigger>
                                    <DataTrigger TargetType="Border" Binding="{Binding IstGesperrt}" Value="False">
                                        <Setter Property="BackgroundColor" Value="White" />
                                    </DataTrigger>
                                </Border.Triggers>
                                <Label Text="{Binding Wert}" 
                                       FontSize="28" 
                                       FontAttributes="Bold" 
                                       TextColor="Black"
                                       HorizontalOptions="Center" 
                                       VerticalOptions="Center" />
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </HorizontalStackLayout>

                <!-- 3. Der Würfeln-Button -->
                <Button Grid.Row="2"
                        Text="Würfeln"
                        Command="{Binding WuerfelnCommand}"
                        Background="BlanchedAlmond"
                        TextColor="Black"
                        FontAttributes="Bold"
                        HeightRequest="50" />
            </Grid>
        </Grid>
    </ContentPage.Content>
</ContentPage>