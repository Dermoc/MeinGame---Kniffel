<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="MeinGame.View.GameplayPage"
    xmlns="http://schemas.microsoft.com/dotnet/maui/global"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:d="http://schemas.microsoft.com/dotnet/maui/global/design"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewmodel="clr-namespace:MeinGame.ViewModel"
    xmlns:local="clr-namespace:MeinGame.View"
    mc:Ignorable="d">
    <ContentPage.Content>




        <Grid ColumnDefinitions="*, Auto">


            <!-- LINKER BEREICH: SCROLLBARER WERTUNGSZETTEL -->
            <ScrollView Grid.Column="0" 
                        VerticalScrollBarVisibility="Never"
                        Padding="4">

                <Grid RowDefinitions="Auto, Auto, Auto, Auto, Auto, Auto, Auto, Auto, Auto, Auto, Auto, Auto, Auto, Auto, Auto, Auto, Auto, Auto, Auto"
                      ColumnDefinitions="1.8*, *, *"
                      RowSpacing="3"
                      ColumnSpacing="4">

                    <!-- ========================================== -->
                    <!-- ZEILE 0: KOPFZEILE (SPIELER & STATUS)     -->
                    <!-- ========================================== -->
                    <Border Grid.Row="0" Grid.Column="0" BackgroundColor="#E9ECEF" StrokeShape="RoundRectangle 6" StrokeThickness="0">
                        <Label Text="Kategorie" FontAttributes="Bold" FontSize="13" TextColor="#495057" HorizontalTextAlignment="Center" VerticalOptions="Center"/>
                    </Border>

                    <!-- Spieler 1 Header mit Aktiv-Indikator -->
                    <Border Grid.Row="0" Grid.Column="1" StrokeShape="RoundRectangle 6" MinimumHeightRequest="40">
                        <Border.Triggers>
                            <DataTrigger TargetType="Border" Binding="{Binding IsPlayerOneTurn}" Value="True">
                                <Setter Property="BackgroundColor" Value="#D4EDDA"/>
                                <Setter Property="Stroke" Value="#28A745"/>
                                <Setter Property="StrokeThickness" Value="2"/>
                            </DataTrigger>
                            <DataTrigger TargetType="Border" Binding="{Binding IsPlayerOneTurn}" Value="False">
                                <Setter Property="BackgroundColor" Value="#F8F9FA"/>
                                <Setter Property="Stroke" Value="#CED4DA"/>
                                <Setter Property="StrokeThickness" Value="1"/>
                            </DataTrigger>
                        </Border.Triggers>
                        <Label Text="{Binding Spieler1.PlayerName}" FontAttributes="Bold" FontSize="13" TextColor="Black" HorizontalTextAlignment="Center" VerticalOptions="Center"/>
                    </Border>

                    <!-- Spieler 2 Header mit Aktiv-Indikator -->
                    <Border Grid.Row="0" Grid.Column="2" StrokeShape="RoundRectangle 6" MinimumHeightRequest="40">
                        <Border.Triggers>
                            <DataTrigger TargetType="Border" Binding="{Binding IsPlayerOneTurn}" Value="False">
                                <Setter Property="BackgroundColor" Value="#D4EDDA"/>
                                <Setter Property="Stroke" Value="#28A745"/>
                                <Setter Property="StrokeThickness" Value="2"/>
                            </DataTrigger>
                            <DataTrigger TargetType="Border" Binding="{Binding IsPlayerOneTurn}" Value="True">
                                <Setter Property="BackgroundColor" Value="#F8F9FA"/>
                                <Setter Property="Stroke" Value="#CED4DA"/>
                                <Setter Property="StrokeThickness" Value="1"/>
                            </DataTrigger>
                        </Border.Triggers>
                        <Label Text="{Binding Spieler2.PlayerName}" FontAttributes="Bold" FontSize="13" TextColor="Black" HorizontalTextAlignment="Center" VerticalOptions="Center"/>
                    </Border>


                    <!-- ========================================== -->
                    <!-- OBERER TEIL (EINGABEZEILEN 1 - 6)          -->
                    <!-- ========================================== -->
                    <!-- 1er -->
                    <Border Grid.Row="1" Grid.Column="0" BackgroundColor="#F8F9FA" StrokeShape="RoundRectangle 4" StrokeThickness="0">
                        <Label Text="1er" FontSize="13" Margin="8,0" VerticalOptions="Center"/>
                    </Border>
                    <Border Grid.Row="1" Grid.Column="1" BackgroundColor="White" Stroke="#E0E0E0" StrokeShape="RoundRectangle 4" MinimumHeightRequest="36">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ErgebnisEintragenCommand}" CommandParameter="Einser"/>
                        </Border.GestureRecognizers>
                        <Label Text="{Binding Spieler1.Einser}" FontSize="15" FontAttributes="Bold" TextColor="Black" HorizontalOptions="Center" VerticalOptions="Center"/>
                    </Border>
                    <Border Grid.Row="1" Grid.Column="2" BackgroundColor="White" Stroke="#E0E0E0" StrokeShape="RoundRectangle 4" MinimumHeightRequest="36">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ErgebnisEintragenCommand}" CommandParameter="Einser"/>
                        </Border.GestureRecognizers>
                        <Label Text="{Binding Spieler2.Einser}" FontSize="15" FontAttributes="Bold" TextColor="Black" HorizontalOptions="Center" VerticalOptions="Center"/>
                    </Border>

                    <!-- 2er -->
                    <Border Grid.Row="2" Grid.Column="0" BackgroundColor="#F8F9FA" StrokeShape="RoundRectangle 4" StrokeThickness="0">
                        <Label Text="2er" FontSize="13" Margin="8,0" VerticalOptions="Center"/>
                    </Border>
                    <Border Grid.Row="2" Grid.Column="1" BackgroundColor="White" Stroke="#E0E0E0" StrokeShape="RoundRectangle 4" MinimumHeightRequest="36">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ErgebnisEintragenCommand}" CommandParameter="Zweier"/>
                        </Border.GestureRecognizers>
                        <Label Text="{Binding Spieler1.Zweier}" FontSize="15" FontAttributes="Bold" TextColor="Black" HorizontalOptions="Center" VerticalOptions="Center"/>
                    </Border>
                    <Border Grid.Row="2" Grid.Column="2" BackgroundColor="White" Stroke="#E0E0E0" StrokeShape="RoundRectangle 4" MinimumHeightRequest="36">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ErgebnisEintragenCommand}" CommandParameter="Zweier"/>
                        </Border.GestureRecognizers>
                        <Label Text="{Binding Spieler2.Zweier}" FontSize="15" FontAttributes="Bold" TextColor="Black" HorizontalOptions="Center" VerticalOptions="Center"/>
                    </Border>

                    <!-- 3er -->
                    <Border Grid.Row="3" Grid.Column="0" BackgroundColor="#F8F9FA" StrokeShape="RoundRectangle 4" StrokeThickness="0">
                        <Label Text="3er" FontSize="13" Margin="8,0" VerticalOptions="Center"/>
                    </Border>
                    <Border Grid.Row="3" Grid.Column="1" BackgroundColor="White" Stroke="#E0E0E0" StrokeShape="RoundRectangle 4" MinimumHeightRequest="36">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ErgebnisEintragenCommand}" CommandParameter="Dreier"/>
                        </Border.GestureRecognizers>
                        <Label Text="{Binding Spieler1.Dreier}" FontSize="15" FontAttributes="Bold" TextColor="Black" HorizontalOptions="Center" VerticalOptions="Center"/>
                    </Border>
                    <Border Grid.Row="3" Grid.Column="2" BackgroundColor="White" Stroke="#E0E0E0" StrokeShape="RoundRectangle 4" MinimumHeightRequest="36">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ErgebnisEintragenCommand}" CommandParameter="Dreier"/>
                        </Border.GestureRecognizers>
                        <Label Text="{Binding Spieler2.Dreier}" FontSize="15" FontAttributes="Bold" TextColor="Black" HorizontalOptions="Center" VerticalOptions="Center"/>
                    </Border>

                    <!-- 4er -->
                    <Border Grid.Row="4" Grid.Column="0" BackgroundColor="#F8F9FA" StrokeShape="RoundRectangle 4" StrokeThickness="0">
                        <Label Text="4er" FontSize="13" Margin="8,0" VerticalOptions="Center"/>
                    </Border>
                    <Border Grid.Row="4" Grid.Column="1" BackgroundColor="White" Stroke="#E0E0E0" StrokeShape="RoundRectangle 4" MinimumHeightRequest="36">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ErgebnisEintragenCommand}" CommandParameter="Vierer"/>
                        </Border.GestureRecognizers>
                        <Label Text="{Binding Spieler1.Vierer}" FontSize="15" FontAttributes="Bold" TextColor="Black" HorizontalOptions="Center" VerticalOptions="Center"/>
                    </Border>
                    <Border Grid.Row="4" Grid.Column="2" BackgroundColor="White" Stroke="#E0E0E0" StrokeShape="RoundRectangle 4" MinimumHeightRequest="36">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ErgebnisEintragenCommand}" CommandParameter="Vierer"/>
                        </Border.GestureRecognizers>
                        <Label Text="{Binding Spieler2.Vierer}" FontSize="15" FontAttributes="Bold" TextColor="Black" HorizontalOptions="Center" VerticalOptions="Center"/>
                    </Border>

                    <!-- 5er -->
                    <Border Grid.Row="5" Grid.Column="0" BackgroundColor="#F8F9FA" StrokeShape="RoundRectangle 4" StrokeThickness="0">
                        <Label Text="5er" FontSize="13" Margin="8,0" VerticalOptions="Center"/>
                    </Border>
                    <Border Grid.Row="5" Grid.Column="1" BackgroundColor="White" Stroke="#E0E0E0" StrokeShape="RoundRectangle 4" MinimumHeightRequest="36">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ErgebnisEintragenCommand}" CommandParameter="Fuenfer"/>
                        </Border.GestureRecognizers>
                        <Label Text="{Binding Spieler1.Fuenfer}" FontSize="15" FontAttributes="Bold" TextColor="Black" HorizontalOptions="Center" VerticalOptions="Center"/>
                    </Border>
                    <Border Grid.Row="5" Grid.Column="2" BackgroundColor="White" Stroke="#E0E0E0" StrokeShape="RoundRectangle 4" MinimumHeightRequest="36">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ErgebnisEintragenCommand}" CommandParameter="Fuenfer"/>
                        </Border.GestureRecognizers>
                        <Label Text="{Binding Spieler2.Fuenfer}" FontSize="15" FontAttributes="Bold" TextColor="Black" HorizontalOptions="Center" VerticalOptions="Center"/>
                    </Border>

                    <!-- 6er -->
                    <Border Grid.Row="6" Grid.Column="0" BackgroundColor="#F8F9FA" StrokeShape="RoundRectangle 4" StrokeThickness="0">
                        <Label Text="6er" FontSize="13" Margin="8,0" VerticalOptions="Center"/>
                    </Border>
                    <Border Grid.Row="6" Grid.Column="1" BackgroundColor="White" Stroke="#E0E0E0" StrokeShape="RoundRectangle 4" MinimumHeightRequest="36">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ErgebnisEintragenCommand}" CommandParameter="Sechser"/>
                        </Border.GestureRecognizers>
                        <Label Text="{Binding Spieler1.Sechser}" FontSize="15" FontAttributes="Bold" TextColor="Black" HorizontalOptions="Center" VerticalOptions="Center"/>
                    </Border>
                    <Border Grid.Row="6" Grid.Column="2" BackgroundColor="White" Stroke="#E0E0E0" StrokeShape="RoundRectangle 4" MinimumHeightRequest="36">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ErgebnisEintragenCommand}" CommandParameter="Sechser"/>
                        </Border.GestureRecognizers>
                        <Label Text="{Binding Spieler2.Sechser}" FontSize="15" FontAttributes="Bold" TextColor="Black" HorizontalOptions="Center" VerticalOptions="Center"/>
                    </Border>


                    <!-- ========================================== -->
                    <!-- ZWISCHENSUMMEN OBEN (ZEILEN 7 - 9)         -->
                    <!-- ========================================== -->
                    <!-- Summe Oben -->
                    <Border Grid.Row="7" Grid.Column="0" BackgroundColor="#E9ECEF" StrokeShape="RoundRectangle 4" StrokeThickness="0">
                        <Label Text="Summe Oben" FontSize="12" FontAttributes="Bold" Margin="8,0" VerticalOptions="Center"/>
                    </Border>
                    <Border Grid.Row="7" Grid.Column="1" BackgroundColor="#E9ECEF" StrokeShape="RoundRectangle 4" StrokeThickness="0">
                        <Label Text="{Binding Spieler1.GesamtOben}" FontAttributes="Bold" FontSize="14" HorizontalTextAlignment="Center" VerticalOptions="Center"/>
                    </Border>
                    <Border Grid.Row="7" Grid.Column="2" BackgroundColor="#E9ECEF" StrokeShape="RoundRectangle 4" StrokeThickness="0">
                        <Label Text="{Binding Spieler2.GesamtOben}" FontAttributes="Bold" FontSize="14" HorizontalTextAlignment="Center" VerticalOptions="Center"/>
                    </Border>

                    <!-- Bonus -->
                    <Border Grid.Row="8" Grid.Column="0" BackgroundColor="#E9ECEF" StrokeShape="RoundRectangle 4" StrokeThickness="0">
                        <Label Text="Bonus (≥63)" FontSize="11" TextColor="#6C757D" Margin="8,0" VerticalOptions="Center"/>
                    </Border>
                    <Border Grid.Row="8" Grid.Column="1" BackgroundColor="#E9ECEF" StrokeShape="RoundRectangle 4" StrokeThickness="0">
                        <Label Text="{Binding Spieler1.Bonus}" FontSize="13" TextColor="#28A745" HorizontalTextAlignment="Center" VerticalOptions="Center"/>
                    </Border>
                    <Border Grid.Row="8" Grid.Column="2" BackgroundColor="#E9ECEF" StrokeShape="RoundRectangle 4" StrokeThickness="0">
                        <Label Text="{Binding Spieler2.Bonus}" FontSize="13" TextColor="#28A745" HorizontalTextAlignment="Center" VerticalOptions="Center"/>
                    </Border>

                    <!-- Gesamt Oben inkl. Bonus -->
                    <Border Grid.Row="9" Grid.Column="0" BackgroundColor="#DEE2E6" StrokeShape="RoundRectangle 4" StrokeThickness="0">
                        <Label Text="Gesamt Oben" FontSize="12" FontAttributes="Bold" Margin="8,0" VerticalOptions="Center"/>
                    </Border>
                    <Border Grid.Row="9" Grid.Column="1" BackgroundColor="#DEE2E6" StrokeShape="RoundRectangle 4" StrokeThickness="0">
                        <Label Text="{Binding Spieler1.GesamtObenMitBonus}" FontAttributes="Bold" FontSize="14" HorizontalTextAlignment="Center" VerticalOptions="Center"/>
                    </Border>
                    <Border Grid.Row="9" Grid.Column="2" BackgroundColor="#DEE2E6" StrokeShape="RoundRectangle 4" StrokeThickness="0">
                        <Label Text="{Binding Spieler2.GesamtObenMitBonus}" FontAttributes="Bold" FontSize="14" HorizontalTextAlignment="Center" VerticalOptions="Center"/>
                    </Border>


                    <!-- ========================================== -->
                    <!-- UNTERER TEIL (EINGABEZEILEN 10 - 16)       -->
                    <!-- ========================================== -->
                    <!-- 3er Pasch -->
                    <Border Grid.Row="10" Grid.Column="0" BackgroundColor="#F8F9FA" StrokeShape="RoundRectangle 4" StrokeThickness="0">
                        <Label Text="3er Pasch" FontSize="13" Margin="8,0" VerticalOptions="Center"/>
                    </Border>
                    <Border Grid.Row="10" Grid.Column="1" BackgroundColor="White" Stroke="#E0E0E0" StrokeShape="RoundRectangle 4" MinimumHeightRequest="36">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ErgebnisEintragenCommand}" CommandParameter="DreierPasch"/>
                        </Border.GestureRecognizers>
                        <Label Text="{Binding Spieler1.DreierPasch}" FontSize="15" FontAttributes="Bold" TextColor="Black" HorizontalOptions="Center" VerticalOptions="Center"/>
                    </Border>
                    <Border Grid.Row="10" Grid.Column="2" BackgroundColor="White" Stroke="#E0E0E0" StrokeShape="RoundRectangle 4" MinimumHeightRequest="36">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ErgebnisEintragenCommand}" CommandParameter="DreierPasch"/>
                        </Border.GestureRecognizers>
                        <Label Text="{Binding Spieler2.DreierPasch}" FontSize="15" FontAttributes="Bold" TextColor="Black" HorizontalOptions="Center" VerticalOptions="Center"/>
                    </Border>

                    <!-- 4er Pasch -->
                    <Border Grid.Row="11" Grid.Column="0" BackgroundColor="#F8F9FA" StrokeShape="RoundRectangle 4" StrokeThickness="0">
                        <Label Text="4er Pasch" FontSize="13" Margin="8,0" VerticalOptions="Center"/>
                    </Border>
                    <Border Grid.Row="11" Grid.Column="1" BackgroundColor="White" Stroke="#E0E0E0" StrokeShape="RoundRectangle 4" MinimumHeightRequest="36">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ErgebnisEintragenCommand}" CommandParameter="ViererPasch"/>
                        </Border.GestureRecognizers>
                        <Label Text="{Binding Spieler1.ViererPasch}" FontSize="15" FontAttributes="Bold" TextColor="Black" HorizontalOptions="Center" VerticalOptions="Center"/>
                    </Border>
                    <Border Grid.Row="11" Grid.Column="2" BackgroundColor="White" Stroke="#E0E0E0" StrokeShape="RoundRectangle 4" MinimumHeightRequest="36">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ErgebnisEintragenCommand}" CommandParameter="ViererPasch"/>
                        </Border.GestureRecognizers>
                        <Label Text="{Binding Spieler2.ViererPasch}" FontSize="15" FontAttributes="Bold" TextColor="Black" HorizontalOptions="Center" VerticalOptions="Center"/>
                    </Border>

                    <!-- Full House -->
                    <Border Grid.Row="12" Grid.Column="0" BackgroundColor="#F8F9FA" StrokeShape="RoundRectangle 4" StrokeThickness="0">
                        <Label Text="Full House" FontSize="13" Margin="8,0" VerticalOptions="Center"/>
                    </Border>
                    <Border Grid.Row="12" Grid.Column="1" BackgroundColor="White" Stroke="#E0E0E0" StrokeShape="RoundRectangle 4" MinimumHeightRequest="36">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ErgebnisEintragenCommand}" CommandParameter="FullHouse"/>
                        </Border.GestureRecognizers>
                        <Label Text="{Binding Spieler1.FullHouse}" FontSize="15" FontAttributes="Bold" TextColor="Black" HorizontalOptions="Center" VerticalOptions="Center"/>
                    </Border>
                    <Border Grid.Row="12" Grid.Column="2" BackgroundColor="White" Stroke="#E0E0E0" StrokeShape="RoundRectangle 4" MinimumHeightRequest="36">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ErgebnisEintragenCommand}" CommandParameter="FullHouse"/>
                        </Border.GestureRecognizers>
                        <Label Text="{Binding Spieler2.FullHouse}" FontSize="15" FontAttributes="Bold" TextColor="Black" HorizontalOptions="Center" VerticalOptions="Center"/>
                    </Border>

                    <!-- Kl. Strasse -->
                    <Border Grid.Row="13" Grid.Column="0" BackgroundColor="#F8F9FA" StrokeShape="RoundRectangle 4" StrokeThickness="0">
                        <Label Text="Kl. Strasse" FontSize="13" Margin="8,0" VerticalOptions="Center"/>
                    </Border>
                    <Border Grid.Row="13" Grid.Column="1" BackgroundColor="White" Stroke="#E0E0E0" StrokeShape="RoundRectangle 4" MinimumHeightRequest="36">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ErgebnisEintragenCommand}" CommandParameter="KleineStrasse"/>
                        </Border.GestureRecognizers>
                        <Label Text="{Binding Spieler1.KleineStrasse}" FontSize="15" FontAttributes="Bold" TextColor="Black" HorizontalOptions="Center" VerticalOptions="Center"/>
                    </Border>
                    <Border Grid.Row="13" Grid.Column="2" BackgroundColor="White" Stroke="#E0E0E0" StrokeShape="RoundRectangle 4" MinimumHeightRequest="36">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ErgebnisEintragenCommand}" CommandParameter="KleineStrasse"/>
                        </Border.GestureRecognizers>
                        <Label Text="{Binding Spieler2.KleineStrasse}" FontSize="15" FontAttributes="Bold" TextColor="Black" HorizontalOptions="Center" VerticalOptions="Center"/>
                    </Border>

                    <!-- Gr. Strasse -->
                    <Border Grid.Row="14" Grid.Column="0" BackgroundColor="#F8F9FA" StrokeShape="RoundRectangle 4" StrokeThickness="0">
                        <Label Text="Gr. Strasse" FontSize="13" Margin="8,0" VerticalOptions="Center"/>
                    </Border>
                    <Border Grid.Row="14" Grid.Column="1" BackgroundColor="White" Stroke="#E0E0E0" StrokeShape="RoundRectangle 4" MinimumHeightRequest="36">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ErgebnisEintragenCommand}" CommandParameter="GrosseStrasse"/>
                        </Border.GestureRecognizers>
                        <Label Text="{Binding Spieler1.GrosseStrasse}" FontSize="15" FontAttributes="Bold" TextColor="Black" HorizontalOptions="Center" VerticalOptions="Center"/>
                    </Border>
                    <Border Grid.Row="14" Grid.Column="2" BackgroundColor="White" Stroke="#E0E0E0" StrokeShape="RoundRectangle 4" MinimumHeightRequest="36">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ErgebnisEintragenCommand}" CommandParameter="GrosseStrasse"/>
                        </Border.GestureRecognizers>
                        <Label Text="{Binding Spieler2.GrosseStrasse}" FontSize="15" FontAttributes="Bold" TextColor="Black" HorizontalOptions="Center" VerticalOptions="Center"/>
                    </Border>

                    <!-- JepJep -->
                    <Border Grid.Row="15" Grid.Column="0" BackgroundColor="#F8F9FA" StrokeShape="RoundRectangle 4" StrokeThickness="0">
                        <Label Text="JepJep" FontSize="13" Margin="8,0" VerticalOptions="Center"/>
                    </Border>
                    <Border Grid.Row="15" Grid.Column="1" BackgroundColor="White" Stroke="#E0E0E0" StrokeShape="RoundRectangle 4" MinimumHeightRequest="36">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ErgebnisEintragenCommand}" CommandParameter="JepJep"/>
                        </Border.GestureRecognizers>
                        <Label Text="{Binding Spieler1.JepJep}" FontSize="15" FontAttributes="Bold" TextColor="Black" HorizontalOptions="Center" VerticalOptions="Center"/>
                    </Border>
                    <Border Grid.Row="15" Grid.Column="2" BackgroundColor="White" Stroke="#E0E0E0" StrokeShape="RoundRectangle 4" MinimumHeightRequest="36">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ErgebnisEintragenCommand}" CommandParameter="JepJep"/>
                        </Border.GestureRecognizers>
                        <Label Text="{Binding Spieler2.JepJep}" FontSize="15" FontAttributes="Bold" TextColor="Black" HorizontalOptions="Center" VerticalOptions="Center"/>
                    </Border>

                    <!-- Chance -->
                    <Border Grid.Row="16" Grid.Column="0" BackgroundColor="#F8F9FA" StrokeShape="RoundRectangle 4" StrokeThickness="0">
                        <Label Text="Chance" FontSize="13" Margin="8,0" VerticalOptions="Center"/>
                    </Border>
                    <Border Grid.Row="16" Grid.Column="1" BackgroundColor="White" Stroke="#E0E0E0" StrokeShape="RoundRectangle 4" MinimumHeightRequest="36">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ErgebnisEintragenCommand}" CommandParameter="Chance"/>
                        </Border.GestureRecognizers>
                        <Label Text="{Binding Spieler1.Chance}" FontSize="15" FontAttributes="Bold" TextColor="Black" HorizontalOptions="Center" VerticalOptions="Center"/>
                    </Border>
                    <Border Grid.Row="16" Grid.Column="2" BackgroundColor="White" Stroke="#E0E0E0" StrokeShape="RoundRectangle 4" MinimumHeightRequest="36">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ErgebnisEintragenCommand}" CommandParameter="Chance"/>
                        </Border.GestureRecognizers>
                        <Label Text="{Binding Spieler2.Chance}" FontSize="15" FontAttributes="Bold" TextColor="Black" HorizontalOptions="Center" VerticalOptions="Center"/>
                    </Border>


                    <!-- ========================================== -->
                    <!-- GESAMTSUMMEN (ZEILEN 17 & 18)              -->
                    <!-- ========================================== -->
                    <!-- Summe Unten -->
                    <Border Grid.Row="17" Grid.Column="0" BackgroundColor="#E9ECEF" StrokeShape="RoundRectangle 4" StrokeThickness="0">
                        <Label Text="Summe Unten" FontSize="12" FontAttributes="Bold" Margin="8,0" VerticalOptions="Center"/>
                    </Border>
                    <Border Grid.Row="17" Grid.Column="1" BackgroundColor="#E9ECEF" StrokeShape="RoundRectangle 4" StrokeThickness="0">
                        <Label Text="{Binding Spieler1.GesamtUnten}" FontAttributes="Bold" FontSize="14" HorizontalTextAlignment="Center" VerticalOptions="Center"/>
                    </Border>
                    <Border Grid.Row="17" Grid.Column="2" BackgroundColor="#E9ECEF" StrokeShape="RoundRectangle 4" StrokeThickness="0">
                        <Label Text="{Binding Spieler2.GesamtUnten}" FontAttributes="Bold" FontSize="14" HorizontalTextAlignment="Center" VerticalOptions="Center"/>
                    </Border>

                    <!-- ENDSUMME (Akzentuiert) -->
                    <Border Grid.Row="18" Grid.Column="0" BackgroundColor="#212529" StrokeShape="RoundRectangle 6" StrokeThickness="0" MinimumHeightRequest="42">
                        <Label Text="ENDSUMME" FontAttributes="Bold" FontSize="13" TextColor="White" Margin="8,0" VerticalOptions="Center"/>
                    </Border>
                    <Border Grid.Row="18" Grid.Column="1" BackgroundColor="#E8F5E9" Stroke="#4CAF50" StrokeThickness="1.5" StrokeShape="RoundRectangle 6" MinimumHeightRequest="42">
                        <Label Text="{Binding Spieler1.Endsumme}" FontAttributes="Bold" FontSize="16" TextColor="#2E7D32" HorizontalTextAlignment="Center" VerticalOptions="Center"/>
                    </Border>
                    <Border Grid.Row="18" Grid.Column="2" BackgroundColor="#E8F5E9" Stroke="#4CAF50" StrokeThickness="1.5" StrokeShape="RoundRectangle 6" MinimumHeightRequest="42">
                        <Label Text="{Binding Spieler2.Endsumme}" FontAttributes="Bold" FontSize="16" TextColor="#2E7D32" HorizontalTextAlignment="Center" VerticalOptions="Center"/>
                    </Border>

                </Grid>
            </ScrollView>



            <!-- RECHTE SEITE: Statusanzeige, Würfel und Button -->
            <Grid Grid.Column="1" RowDefinitions="Auto, *, Auto" Margin="10">

                <!-- 1. Status-Infokarte -->
                <Border Grid.Row="0"
                        Stroke="#CCCCCC"
                        StrokeShape="RoundRectangle 8"
                        BackgroundColor="#F8F9FA"
                        Padding="12"
                        Margin="0,0,0,10">
                    <VerticalStackLayout Spacing="4">
                        <HorizontalStackLayout HorizontalOptions="Center" Spacing="6">
                            <Label Text="Am Zug:" FontSize="14" TextColor="Gray"/>
                            <Label Text="{Binding AktuellerSpielerName}" FontSize="16" FontAttributes="Bold" TextColor="#28A745"/>
                        </HorizontalStackLayout>

                        <Label Text="{Binding WurfStatusText}" 
                               FontSize="18" 
                               FontAttributes="Bold" 
                               HorizontalOptions="Center" 
                               TextColor="Black"/>

                        <Label Text="{Binding VerbleibendeWuerfeText}" 
                               FontSize="12" 
                               HorizontalOptions="Center" 
                               TextColor="Gray"/>
                    </VerticalStackLayout>
                </Border>

                <!-- 2. Die 5 Würfel -->
                <HorizontalStackLayout Grid.Row="1"
                                       BindableLayout.ItemsSource="{Binding WuerfelListe}"
                                       Spacing="10"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate>
                            <Border WidthRequest="60" 
                                    HeightRequest="60" 
                                    Stroke="Black" 
                                    StrokeThickness="2"
                                    StrokeShape="RoundRectangle 8">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer 
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodel:GameplayViewModel}}, Path=WuerfelSperrenCommand}"
                                        CommandParameter="{Binding .}" />
                                </Border.GestureRecognizers>
                                <Border.Triggers>
                                    <DataTrigger TargetType="Border" Binding="{Binding IstGesperrt}" Value="True">
                                        <Setter Property="BackgroundColor" Value="LightGray" />
                                    </DataTrigger>
                                    <DataTrigger TargetType="Border" Binding="{Binding IstGesperrt}" Value="False">
                                        <Setter Property="BackgroundColor" Value="White" />
                                    </DataTrigger>
                                </Border.Triggers>
                                <Label Text="{Binding Wert}" 
                                       FontSize="28" 
                                       FontAttributes="Bold" 
                                       TextColor="Black"
                                       HorizontalOptions="Center" 
                                       VerticalOptions="Center" />
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </HorizontalStackLayout>

                <!-- 3. Der Würfeln-Button -->
                <Button Grid.Row="2"
                        Text="Würfeln"
                        Command="{Binding WuerfelnCommand}"
                        Background="BlanchedAlmond"
                        TextColor="Black"
                        FontAttributes="Bold"
                        HeightRequest="50" />
            </Grid>
        </Grid>
    </ContentPage.Content>
</ContentPage>