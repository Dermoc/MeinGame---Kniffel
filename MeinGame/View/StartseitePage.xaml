<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="MeinGame.View.StartseitePage"
    xmlns="http://schemas.microsoft.com/dotnet/maui/global"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:d="http://schemas.microsoft.com/dotnet/maui/global/design"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="clr-namespace:MeinGame.View"
    mc:Ignorable="d">

    <ContentPage.Content>
        <Grid RowDefinitions="*,*"
              ColumnDefinitions="*,*"
              Background="Beige"
              Padding="10"
              RowSpacing="10"
              ColumnSpacing="10">

            <!-- FELD 1 (Oben Links): Start des Spiels -->
            <Border Grid.Row="0"
                    Grid.Column="0"
                    Background="Aqua"
                    StrokeThickness="3"
                    StrokeShape="RoundRectangle 25">

                <Button x:Name="btnStartGame"
                        Text="Spiel starten"
                        TextColor="Black"
                        FontAttributes="Bold"
                        FontSize="18"
                        Clicked="btnStartGame_Clicked" />
            </Border>

            <!-- FELD 2 (Oben Rechts): NAMENSEINGABE FÜR SPIELER 1 & 2 -->
            <Border Grid.Row="0"
                    Grid.Column="1"
                    Background="Aqua"
                    StrokeThickness="3"
                    StrokeShape="RoundRectangle 25"
                    Padding="15">

                <VerticalStackLayout Spacing="8" VerticalOptions="Center">
                    <Label Text="Spieler-Namen"
                           FontAttributes="Bold"
                           FontSize="16"
                           TextColor="Black"
                           HorizontalOptions="Center" />

                    <!-- Eingabe Spieler 1 -->
                    <Entry x:Name="txtPlayer1"
                           Text="Spieler 1"
                           Placeholder="Name Spieler 1"
                           TextColor="Black"
                           BackgroundColor="White" />

                    <!-- Eingabe Spieler 2 -->
                    <Entry x:Name="txtPlayer2"
                           Text="Spieler 2"
                           Placeholder="Name Spieler 2"
                           TextColor="Black"
                           BackgroundColor="White" />
                </VerticalStackLayout>
            </Border>

            <!-- FELD 3 (Unten Links): STATISTIK / HISTORIE -->
            <Border Grid.Row="1"
                    Grid.Column="0"
                    Background="Aqua"
                    StrokeThickness="3"
                    StrokeShape="RoundRectangle 25">

                <Button x:Name="btnStatistik"
                        Text="Statistik"
                        TextColor="Black"
                        FontAttributes="Bold"
                        FontSize="18"
                        Clicked="btnStatistik_Clicked" />
            </Border>

            <!-- FELD 4 (Unten Rechts) -->
            <Border Grid.Row="1"
                    Grid.Column="1"
                    Background="Aqua"
                    StrokeThickness="3"
                    StrokeShape="RoundRectangle 25">

                <Button Text="Beenden"
                        TextColor="Black" />
            </Border>

        </Grid>
    </ContentPage.Content>
</ContentPage>